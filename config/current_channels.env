# Axio Fusion API - non-secret environment template
#
# This tracked file intentionally contains no endpoint credentials. Copy the
# operator-only values to private/current_channels.env or inject them through
# a secret manager before making provider requests.
export AXIO_FUSION_NETWORK_MODE=auto
export AXIO_FUSION_SYSTEM_PROXY=http://127.0.0.1:10808
export AXIO_FUSION_PROVIDER_CONFIG_FILE=/home/he/axio_fusion_api/config/current_channels.example.json
export AXIO_FUSION_REGISTRY_PATH=/home/he/axio_fusion_api/private/serving_registry.json

# CPA Plus channel (Responses / Anthropic per-model binding)
export AXIO_CPA_PLUS_BASE_URL=
export AXIO_CPA_PLUS_API_KEY=
export AXIO_CPA_PLUS_MODELS=
export AXIO_FUSION_IMAGE_REGISTRY_PATH=

# NVIDIA Chat Completions channel
export AXIO_NVIDIA_BASE_URL=
export AXIO_NVIDIA_API_KEYS=
export AXIO_NVIDIA_MODELS=
