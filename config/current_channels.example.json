{
  "providers": [
    {
      "provider": "nvidia",
      "api_format": "chat/completions",
      "base_url_env": "AXIO_NVIDIA_BASE_URL",
      "api_key_env": "AXIO_NVIDIA_API_KEYS",
      "models_env": "AXIO_NVIDIA_MODELS",
      "traffic_control": {
        "scope": "channel",
        "max_in_flight": 1,
        "min_request_interval_ms": 0,
        "post_rate_limit_min_request_interval_ms": 1000,
        "rate_limit_key_pool": "shared",
        "fallback_cooldown_ms": 5000,
        "max_cooldown_ms": 60000
      },
      "reasoning_transport": {
        "status": "candidate",
        "transport": "chat_reasoning_effort",
        "supported_efforts": ["low", "medium", "high"],
        "effort_map": {"xhigh": "high", "max": "high"}
      }
    },
    {
      "provider": "tokenapis",
      "api_format": "responses",
      "base_url_env": "AXIO_TOKENAPIS_BASE_URL",
      "api_key_env": "AXIO_TOKENAPIS_API_KEY",
      "models_env": "AXIO_TOKENAPIS_MODELS",
      "traffic_control": {
        "scope": "profile",
        "max_in_flight": 0,
        "min_request_interval_ms": 0,
        "post_rate_limit_min_request_interval_ms": 1000,
        "rate_limit_key_pool": "shared",
        "fallback_cooldown_ms": 5000,
        "max_cooldown_ms": 60000
      },
      "reasoning_transport": {
        "status": "candidate",
        "transport": "responses_reasoning",
        "supported_efforts": ["low", "medium", "high"],
        "effort_map": {"xhigh": "high", "max": "high"}
      }
    }
  ],
  "prefusion": {
    "focus_manifest": "config/nvidia_focus_models.json",
    "source_manifest": "config/public_model_sources.example.json",
    "research_agent_config": "config/research_agent.example.json",
    "min_available_models": 3,
    "candidate_batch_size": 4,
    "research_max_workers": 1,
    "stream_probe_samples": 3,
    "merge_strategy": "deterministic_research_quality_confidence_candidate_id",
    "ranking_prior_forbidden": true
  }
}
