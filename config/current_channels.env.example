# Non-secret environment contract for config/current_channels.example.json.
# The two current base URLs are deployment seeds and may be overridden.
# Supply API keys and discovered model lists from a secret manager or process
# environment; never put credentials in this file.

export AXIO_FUSION_PROVIDER_CONFIG_FILE="/absolute/path/to/axio_fusion_api/config/current_channels.example.json"

# OpenAI Chat Completions-compatible current channel supplied for the current
# deployment.
export AXIO_NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# Multiple keys may be comma-, semicolon-, or newline-separated.
export AXIO_NVIDIA_API_KEYS="replace-with-nvidia-key-a,replace-with-nvidia-key-b"
export AXIO_NVIDIA_MODELS=""

# Responses-compatible current channel supplied for the current deployment.
export AXIO_TOKENAPIS_BASE_URL="https://tokenapis.com/v1"
export AXIO_TOKENAPIS_API_KEY="replace-with-tokenapis-key"
export AXIO_TOKENAPIS_MODELS=""

# Optional private registry promoted by image-probe-bind. It is deliberately
# loaded separately from the text pre-Fusion registry.
export AXIO_FUSION_IMAGE_REGISTRY_PATH=""

# Outbound network policy for provider and Fusion control-plane HTTP(S) calls.
# auto is the default: probe the configured local proxy listener and use it
# only when it is listening; otherwise use an explicit no-proxy opener.
# on requires the proxy listener and fails closed when it is unavailable.
# off always uses an explicit no-proxy opener and ignores inherited
# HTTP_PROXY/HTTPS_PROXY/ALL_PROXY variables.
export AXIO_FUSION_NETWORK_MODE="auto"
export AXIO_FUSION_SYSTEM_PROXY="http://127.0.0.1:10808"

# Legacy compatibility. AXIO_FUSION_HTTP_PROXY takes precedence as a custom
# proxy when present. AXIO_FUSION_USE_SYSTEM_PROXY=1 maps to legacy forced-on
# behavior only when AXIO_FUSION_NETWORK_MODE is not set.
export AXIO_FUSION_HTTP_PROXY=""
export AXIO_FUSION_USE_SYSTEM_PROXY="0"

# Bounded retry for HTTP-200 provider responses with no text and no native
# tool call. The default is one retry and never becomes an unbounded loop.
export AXIO_FUSION_PROVIDER_EMPTY_RESPONSE_RETRIES="1"

# Consecutive provider failures open a process-local circuit. After this
# cooldown the profile is admitted again for a bounded recovery attempt; a
# successful request clears the failure streak. Set to 0 only when the
# deployment requires manual recovery for an opened circuit.
export AXIO_FUSION_CIRCUIT_BREAKER_COOLDOWN_SECONDS="30"
